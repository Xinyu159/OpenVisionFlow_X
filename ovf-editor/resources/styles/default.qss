/* OpenVisionFlow Editor Default Style */

 QMainWindow {
    background-color: #f5f5f5;
}

 QToolBar {
    background-color: #e0e0e0;
    border: 1px solid #c0c0c0;
    spacing: 5px;
    padding: 3px;
}

 QDockWidget {
    titlebar-close-icon: url(":/icons/close.png");
}

 QDockWidget::title {
    background-color: #e8e8e8;
    padding: 6px;
}

 QGraphicsView {
    background-color: #fafafa;
    border: 1px solid #d0d0d0;
}

 QPushButton {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

 QPushButton:hover {
    background-color: #e8e8e8;
}

 QPushButton:pressed {
    background-color: #d0d0d0;
}

 QTreeView {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
}

 QTreeView::item {
    padding: 4px;
}

 QTreeView::item:selected {
    background-color: #4a90d9;
    color: white;
}

 QComboBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px;
    min-width: 100px;
}

 QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px;
}

 QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px;
}

 QCheckBox {
    spacing: 8px;
}

 QLabel {
    color: #333333;
}

 QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}

 QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

 QScrollArea {
    border: none;
    background-color: transparent;
}

 QMenuBar {
    background-color: #f0f0f0;
}

 QMenuBar::item {
    padding: 6px 10px;
}

 QMenuBar::item:selected {
    background-color: #4a90d9;
    color: white;
}

 QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
}

 QMenu::item {
    padding: 6px 30px;
}

 QMenu::item:selected {
    background-color: #4a90d9;
    color: white;
}

 QStatusBar {
    background-color: #e8e8e8;
    border-top: 1px solid #d0d0d0;
}